# Variables du docker-compose de DEVELOPPEMENT (copier en `.env`, jamais commite).
# Toutes sont obligatoires : `docker compose up` s'arrete si l'une manque.
# Choisir des valeurs propres a chaque poste ; ne pas reutiliser en production.
KC_BOOTSTRAP_ADMIN=changer-moi
KC_BOOTSTRAP_ADMIN_PASSWORD=changer-moi
NEMETON_OAUTH_CLIENT_SECRET=changer-moi
KC_DEMO_PASSWORD=changer-moi
KC_REALM_ADMIN_PASSWORD=changer-moi
